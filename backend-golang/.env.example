# Salin file ini menjadi .env lalu sesuaikan nilainya
APP_PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_cbt_exam

JWT_SECRET=ganti_dengan_secret_panjang_anda

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
