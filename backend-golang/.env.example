# SMTP untuk kirim pemberitahuan email ke peserta
# Untuk Gmail gunakan App Password (bukan password biasa)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=CBT Exam
SMTP_SEND_DELAY_MS=300